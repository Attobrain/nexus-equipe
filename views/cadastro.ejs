
<%- include("partials/header.ejs") %>
<%- include("partials/navbar.ejs") %>

<main class="nexus-register-page">
    <section class="nexus-register-card" aria-labelledby="register-title">

        <div class="nexus-register-card__brand">
            <div class="nexus-register-card__symbol" aria-hidden="true">
                N
            </div>
            <span>NEXUS</span>
        </div>

        <header class="nexus-register-card__heading">
            <p class="nexus-register-card__eyebrow">FAÇA PARTE DA NEXUS</p>
            <h1 id="register-title">Crie sua conta</h1>
            <p>Cadastre-se para acessar sua conta.</p>
        </header>

        <form action="/cadastro/novo"
              method="POST"
              class="nexus-register-form">

            <div class="nexus-register-form__field">
                <label for="email">E-mail</label>
                <input
                    type="email"
                    name="email"
                    id="email"
                    placeholder="seuemail@exemplo.com"
                    autocomplete="email"
                    required
                >
            </div>

            <div class="nexus-register-form__field">
                <label for="password">Senha</label>
                <input
                    type="password"
                    name="password"
                    id="password"
                    placeholder="Crie uma senha"
                    autocomplete="new-password"
                    required
                >
                <span class="nexus-register-form__hint">
                    Escolha uma senha que você não utilize em outros serviços.
                </span>
            </div>

            <button type="submit" class="nexus-register-form__button">
                Criar minha conta
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
            </button>

        </form>

        <div class="nexus-register-card__login">
            <span>Já possui conta?</span>
            <a href="/login">Faça login</a>
        </div>

    </section>
</main>

<%- include("partials/footer.ejs") %>
