<header class="nexus-header" id="inicio">
  <div class="nexus-header__inner">
    <a class="nexus-brand" href="/#inicio" aria-label="Nexus — página inicial">
      <svg class="nexus-brand__symbol" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="nexusLogoGradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#d8b4fe" />
            <stop offset="100%" stop-color="#9333ea" />
          </linearGradient>
        </defs>
        <path fill="url(#nexusLogoGradient)" d="M5 4h6l22 24V9l6 6v25h-6L11 16v19l-6-6z" />
        <path fill="#f5eaff" d="M5 4l6 6v7l-6-6zM33 5l6 6v7l-6-6z" opacity=".92" />
      </svg>
      <span class="nexus-brand__word">NEXUS</span>
    </a>

    <button
      class="nexus-menu-toggle"
      type="button"
      aria-label="Abrir menu de navegação"
      aria-controls="nexus-navigation"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="nexus-nav" id="nexus-navigation" aria-label="Navegação principal">
      <a class="nexus-nav__link nexus-nav__link--active" href="/#" aria-current="page">Início</a>
      <a class="nexus-nav__link" href="/#equipe">Equipe</a>
      <a class="nexus-nav__link" href="/blog">Blog</a>
      <a class="nexus-nav__link" href="/sobre">Sobre</a>
    </nav>

    <a class="nexus-login" href="/login">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="8" r="3.5"></circle>
        <path d="M5.5 20v-1.8a6.5 6.5 0 0 1 13 0V20"></path>
      </svg>
      <span>Entrar</span>
    </a>
  </div>
</header>
