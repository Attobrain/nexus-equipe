              <linearGradient id="nexusFooterLogoGradient" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#e9d5ff" />
                <stop offset="40%" stop-color="#c084fc" />
                <stop offset="100%" stop-color="#7e22ce" />
              </linearGradient>
            </defs>
            <path fill="url(#nexusFooterLogoGradient)" d="M22 17h22l64 64V43l20-20v120h-22L42 79v42l-20 20z" />
            <path fill="#f3e8ff" opacity=".88" d="M22 17 44 39v24L22 41zM108 81l20 20v22l-20-20z" />
          </svg>
          <span class="nexus-footer__wordmark">NEXUS</span>
        </a>

        <h2 class="nexus-footer__title" id="nexus-footer-title">
          Tecnologia com propósito.
        </h2>
        <p class="nexus-footer__description">
          Transformamos ideias em soluções por meio da tecnologia, da inovação e do trabalho em equipe.
        </p>
