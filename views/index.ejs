<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<section class="nexus-hero" aria-labelledby="nexus-hero-title">
  <div class="nexus-hero__inner">
    <div class="nexus-hero__content">
      <p class="nexus-hero__eyebrow">EQUIPE NEXUS</p>

      <h1 class="nexus-hero__title" id="nexus-hero-title">
        Mais que uma equipe,<br>
        <span>um mesmo propósito.</span>
      </h1>

      <p class="nexus-hero__description">
        Somos a Nexus, uma equipe movida por tecnologia,<br class="nexus-hero__desktop-break">
        inovação e vontade de transformar ideias em<br class="nexus-hero__desktop-break">
        soluções reais.
      </p>

      <a class="nexus-hero__button" href="#equipe">
        <span>Conheça nossa equipe</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <div class="nexus-hero__visual" aria-label="Nexus, tecnologia, inovação e impacto">
      <div class="nexus-hero__brand" aria-hidden="true">
        <svg class="nexus-hero__symbol" viewBox="0 0 150 160" role="img" aria-label="">
          <defs>
            <linearGradient id="nexusHeroLogoGradient" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#e9d5ff" />
              <stop offset="40%" stop-color="#c084fc" />
              <stop offset="100%" stop-color="#7e22ce" />
            </linearGradient>
          </defs>
          <path fill="url(#nexusHeroLogoGradient)" d="M22 17h22l64 64V43l20-20v120h-22L42 79v42l-20 20z" />
          <path fill="#f3e8ff" opacity=".88" d="M22 17 44 39v24L22 41zM108 81l20 20v22l-20-20z" />
        </svg>
        <span class="nexus-hero__wordmark">NEXUS</span>
      </div>

      <div class="nexus-hero__keywords" aria-hidden="true">
        <span>TECNOLOGIA</span>
        <span>INOVAÇÃO</span>
        <span>IMPACTO</span>
      </div>
    </div>
  </div>
</section>

<section class="nexus-team" id="equipe" aria-labelledby="nexus-team-title">
  <div class="nexus-team__inner">
    <header class="nexus-team__heading">
      <p class="nexus-team__eyebrow">NOSSA EQUIPE</p>
      <h2 class="nexus-team__title" id="nexus-team-title">Quem somos</h2>
      <p class="nexus-team__description">
        Cada integrante traz uma história, habilidades e uma visão única,<br class="nexus-team__desktop-break">
        mas todos compartilham o mesmo objetivo: construir algo grande.
      </p>
    </header>

    <div class="nexus-team__grid">
      <% if (Array.isArray(membros) && membros.length > 0) { %>
        <% membros.forEach((membro) => { %>
          <article class="nexus-member-card">
            <div class="nexus-member-card__avatar" aria-label="Foto de <%= membro.nome %>">
              <span class="nexus-member-card__initials" aria-hidden="true"><%= membro.iniciais %></span>
              <% if (membro.imagem) { %>
                <img
                  class="nexus-member-card__photo"
                  src="<%= membro.imagem %>"
                  alt="Foto de <%= membro.nome %>"
                  loading="lazy"
                  onerror="this.remove()"
                >
              <% } %>
            </div>

            <h3 class="nexus-member-card__name"><%= membro.nome %></h3>
            <p class="nexus-member-card__role"><%= membro.cargo %></p>

            <div class="nexus-member-card__socials" aria-label="Redes sociais de <%= membro.nome %>">
              <% if (membro.github) { %>
                <a class="nexus-member-card__social" href="<%= membro.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub de <%= membro.nome %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.08c-3.1.67-3.76-1.32-3.76-1.32-.51-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.03 3.12 1.54.1-.72.39-1.21.7-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.27-2.6 5.21-5.08 5.49.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
                </a>
              <% } else { %>
                <span class="nexus-member-card__social nexus-member-card__social--inactive" title="GitHub ainda não informado" aria-label="GitHub ainda não informado">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.08c-3.1.67-3.76-1.32-3.76-1.32-.51-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.03 3.12 1.54.1-.72.39-1.21.7-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.27-2.6 5.21-5.08 5.49.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
                </span>
              <% } %>

              <% if (membro.linkedin) { %>
                <a class="nexus-member-card__social" href="<%= membro.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de <%= membro.nome %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.1a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.4 9h3.7v11.6H3.4V9Zm5.9 0h3.5v1.6h.1a3.9 3.9 0 0 1 3.5-1.9c3.8 0 4.5 2.5 4.5 5.7v6.2h-3.7v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9v5.6H9.3V9Z"/></svg>
                </a>
              <% } else { %>
                <span class="nexus-member-card__social nexus-member-card__social--inactive" title="LinkedIn ainda não informado" aria-label="LinkedIn ainda não informado">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.1a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.4 9h3.7v11.6H3.4V9Zm5.9 0h3.5v1.6h.1a3.9 3.9 0 0 1 3.5-1.9c3.8 0 4.5 2.5 4.5 5.7v6.2h-3.7v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9v5.6H9.3V9Z"/></svg>
                </span>
              <% } %>

              <% if (membro.portfolio) { %>
                <a class="nexus-member-card__social" href="<%= membro.portfolio %>" target="_blank" rel="noopener noreferrer" aria-label="Portfólio de <%= membro.nome %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 3.5 11.9 9h3.2l-6 11.5 1.2-8.1H7.2l3.4-8.9h4.1ZM5 6.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm14 7a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/></svg>
                </a>
              <% } else { %>
                <span class="nexus-member-card__social nexus-member-card__social--inactive" title="Portfólio ainda não informado" aria-label="Portfólio ainda não informado">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 3.5 11.9 9h3.2l-6 11.5 1.2-8.1H7.2l3.4-8.9h4.1ZM5 6.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm14 7a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/></svg>
                </span>
              <% } %>
            </div>

            <p class="nexus-member-card__bio"><%= membro.descricao %></p>
             <a href="/membros/editar/<%= membro.id %>" class="btn-editar-membro">
    <span class="btn-editar-membro__icon">+</span>
    Editar membro </a>
    <a href="/membros/excluir/<%= membro.id %>" class="btn-excluir-membro" onclick="return confirm('Deseja mesmo excluir este Membro?')" >
    <span class="btn-cadastrar-membro__icon">+</span>
    Excluir membro </a>
          </article>
          </article>
          
          
        <% }); %>
        
      <% } else { %>
        
        <p class="nexus-team__empty">Os integrantes da equipe serão exibidos aqui em breve.</p>
      <% } %>
       
      
    </div>
       

    
  </div>
   <a href="/membros/cadastrar/" class="btn-cadastrar-membro">
    <span class="btn-cadastrar-membro__icon">+</span>
    Cadastrar membro </a>

</section>



<section class="nexus-blog" id="blog" aria-labelledby="nexus-blog-title">
  <div class="nexus-blog__inner">
    <header class="nexus-blog__heading">
      <p class="nexus-blog__eyebrow">NOVIDADES DA NEXUS</p>
      <h2 class="nexus-blog__title" id="nexus-blog-title">Por dentro do projeto</h2>
      <p class="nexus-blog__description">
        Acompanhe as atualizações, ideias e etapas do desenvolvimento compartilhadas pela nossa equipe.
      </p>
    </header>

    <div class="nexus-blog__grid">
      <% if (Array.isArray(posts) && posts.length > 0) { %>
        <% posts.slice().reverse().forEach((post) => { %>
          <article class="nexus-post-card">
            <div class="nexus-post-card__meta">
              <span class="nexus-post-card__category"><%= post.categoria || "Atualização" %></span>
              <% if (post.data) { %>
                <span class="nexus-post-card__date"><%= post.data %></span>
              <% } %>
            </div>

            <h3 class="nexus-post-card__title"><%= post.titulo %></h3>

            <% if (post.resumo) { %>
              <p class="nexus-post-card__summary"><%= post.resumo %></p>
            <% } %>

            <% if (post.conteudo) { %>
              <details class="nexus-post-card__details">
                <summary class="nexus-post-card__read-more">
                  <span>Ler publicação</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M5 12h13M13 6l6 6-6 6" />
                  </svg>
                </summary>
                <div class="nexus-post-card__content">
                  <p><%= post.conteudo %></p>
                </div>
              </details>
            <% } %>

            <footer class="nexus-post-card__footer">
              <span class="nexus-post-card__author-label">Publicado por</span>
              <span class="nexus-post-card__author"><%= post.autor || "Equipe Nexus" %></span>
            </footer>
          </article>
        <% }); %>
      <% } else { %>
        <p class="nexus-blog__empty">
          As novidades da Nexus aparecerão aqui em breve.
        </p>
      <% } %>
    </div>
  </div>
</section>

<%- include ('partials/footer.ejs') %>